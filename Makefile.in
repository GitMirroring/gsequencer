AUTOMAKE_OPTIONS = foreign
SUBDIRS = m4 po lib
AM_DISTCHECK_CONFIGURE_FLAGS = --enable-introspection --enable-vst3 --with-poppler
ACLOCAL_AMFLAGS = -I m4 ${ACLOCAL_FLAGS}
@WITH_W32API_FALSE@PIC_FLAGS = -shared -fPIC
@WITH_W32API_TRUE@PIC_FLAGS = -shared -DDLL_EXPORT -DPIC
gsequencer_CFLAGS = @GSEQUENCER_CFLAGS@ $(CFLAGS) $(LIBASOUND2_CFLAGS) \
	$(LIBDSSIALSACOMPAT_CFLAGS) $(LIBAO_CFLAGS) $(LIBXML2_CFLAGS) \
	$(LIBSOUP_CFLAGS) $(SNDFILE_CFLAGS) $(JACK_CFLAGS) \
	$(PULSE_CFLAGS) $(GSTREAMER_CFLAGS) $(LIBINSTPATCH_CFLAGS) \
	$(GOBJECT_CFLAGS) $(CAIRO_CFLAGS) $(GTK_CFLAGS) \
	$(POPPLER_CFLAGS) $(W32API_CFLAGS)
gsequencer_LDFLAGS = @GSEQUENCER_LDFLAGS@ $(am__append_5) -pthread \
	$(am__append_35)
midi2xml_CFLAGS = @GSEQUENCER_CFLAGS@ $(CFLAGS) -I./ \
	$(LIBASOUND2_CFLAGS) $(LIBDSSIALSACOMPAT_CFLAGS) \
	$(LIBXML2_CFLAGS) $(LIBSOUP_CFLAGS) $(GOBJECT_CFLAGS) \
	$(GIO_CFLAGS) $(GSTREAMER_CFLAGS) $(LIBINSTPATCH_CFLAGS) \
	$(W32API_CFLAGS) $(am__append_70)
midi2xml_LDFLAGS = @GSEQUENCER_LDFLAGS@ $(am__append_6) \
	$(LIBASOUND2_LIBS) $(LIBDSSIALSACOMPAT_LIBS) $(LIBXML2_LIBS) \
	$(LIBSOUP_LIBS) $(GOBJECT_LIBS) $(GSTREAMER_LIBS) \
	$(LIBINSTPATCH_LIBS) $(W32API_LIBS)

# this lists the binaries to produce, the (non-PHONY, binary) targets in
# the previous manual Makefile
lib_LTLIBRARIES = libags.la libags_thread.la libags_server.la \
	$(am__append_7) libags_audio.la libags_gui.la
@AGS_WITH_PUBLIC_LIBGSEQUENCER_FALSE@libgsequencerdir = $(libdir)/gsequencer
@AGS_WITH_PUBLIC_LIBGSEQUENCER_TRUE@libgsequencerdir = $(libdir)
libgsequencer_LTLIBRARIES = libgsequencer.la

